{% extends 'blades/html.njk' %}

{% if not site.prod %}
  {% set site = site | attr_set('styles', site.styles | join('|') | replace('https://cdn.jsdelivr.net/npm/@anyblades/blades@2/css', '') | split('|')) %}
{% endif %}


{% set content_for_header %}
  <meta name="generator" content="{{ site.generator }}" />
  <meta property="og:title" content="{{ title | d(site.title) | striptags }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    object {
      /*TODO: move to blades.css */
      vertical-align: middle;
      display: inline-block; /* for Tailwind */
    }
    body > article,
    body > footer {
      text-align: center;
      margin-bottom: 2rem;
      font-size: medium;
    }
  </style>
  {{ content_for_header | safe }}
{% endset %}

{% block body %}
  <article>Generated by <mark>{{ site.title }}</mark> from <code>{{ buildawesome.directories.input }}</code></article>
  <main class="container breakout-all">{{ content | safe }}</main>
  <hr />
  <footer>{{ site.footer | safe }} © {{ site.year }}</footer>
{% endblock %}
