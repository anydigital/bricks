{% capture content_for_header %}
  <meta name="generator" content="{{ site.title }}" />
{% endcapture %}

{% capture body %}
  <main class="container breakout-all">
    Generated by <mark>{{ site.title }}</mark> from <code>{{ buildawesome.directories.input }}</code>
    <hr>
    {{ content }}
  </main>
  <hr>
  <footer class="container">
    {{ site.footer }} © {{ site.year }}
  </footer>
{% endcapture %}

{% include blades/html.liquid %}
